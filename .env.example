# 环境变量示例：复制为 .env 后按需修改（.env 已在 .gitignore 中，不会入库）
# 用法：set -a && source .env && set +a && ./run.sh
#      （Windows 请直接在终端设置这些环境变量）

# ── LLM（不配置则自动降级为离线桩模式，其余功能照常可用）────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 强制离线桩模式（无需任何 Key 即可跑通全链路，用于开发/演示）
# LLM_STUB=true

# ── Embedding + 向量库（RAG）────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# ollama = 真实语义 embedding；stub = 哈希兜底（不依赖 Ollama，仅用于链路验证）
RAG_EMBEDDING=ollama
# RAG_ENABLED=false 可整体关闭 RAG（不创建向量库 bean）

# ── 业务库（默认 H2 文件库，零依赖；切 PG 用 SPRING_PROFILES_ACTIVE=postgres）
# SPRING_PROFILES_ACTIVE=postgres
BIZ_DB_URL=jdbc:postgresql://localhost:5432/interview_biz
BIZ_DB_USER=postgres
BIZ_DB_PASSWORD=

# ── 向量库 ─────────────────────────────────────────────────────────
VECTOR_DB_URL=jdbc:postgresql://localhost:5432/interview_vector
VECTOR_DB_USER=postgres
VECTOR_DB_PASSWORD=

# ── 鉴权（JWT 无状态）──────────────────────────────────────────────
# 密钥必须自己生成：export JWT_SECRET="$(openssl rand -base64 48)"
# 长度 < 32 字节应用会直接启动失败（快速失败，避免悄悄用弱密钥）
JWT_SECRET=
# token 有效期（秒），默认 24 小时
JWT_TTL=86400
# 关闭后所有接口免鉴权（单用户自用 / 本地调试）
SECURITY_ENABLED=true
# 演示账号 demo/demo123，启动时自动创建；生产建议关闭
DEMO_USER_ENABLED=true

# ── 缓存（Redis，不可用时自动跳过，主流程不受影响）────────────────────
CACHE_ENABLED=true
CACHE_TTL=30m
REDIS_HOST=localhost
REDIS_PORT=6379

# ── 异步分析任务（MQ 不可用时自动降级为本地线程池）─────────────────────
ASYNC_ENABLED=true
# mq = RabbitMQ；pool = 本地线程池
ASYNC_MODE=mq
ASYNC_QUEUE=analysis.task.queue
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=interview
RABBITMQ_PASSWORD=interview

# ── 限流（⚠️ 预留：尚未实现，默认关闭；实现后再置 true）────────────────
RATELIMIT_ENABLED=false
# 每分钟请求数上限
RATELIMIT_QPM=60

# ── 调试端点（暴露连接串与注入 prompt，对外部署建议 false）─────────────
DEBUG_ENDPOINTS=true
