# 环境变量示例：复制为 .env 后按需修改（.env 已在 .gitignore 中，不会入库）
# 用法：set -a && source .env && set +a && ./run.sh
#      （Windows 请直接在终端设置这些环境变量）

# ── LLM（不配置则自动降级为离线桩模式，其余功能照常可用）────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 强制离线桩模式（无需任何 Key 即可跑通全链路，用于开发/演示）
# LLM_STUB=true

# ── Embedding + 向量库（RAG）────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# ollama = 真实语义 embedding；stub = 哈希兜底（不依赖 Ollama，仅用于链路验证）
RAG_EMBEDDING=ollama
# 混合检索：向量语义 + 关键词（tsvector + GIN）+ RRF 融合（实测 Hit@1 70% → 85%）
# 关键词通道不可用（业务库与向量库不同库）时自动退化为纯向量
RAG_HYBRID_ENABLED=true
# RAG_ENABLED=false 可整体关闭 RAG（不创建向量库 bean）

# ── embedding 缓存（向量是「模型+文本」的纯函数，可安全缓存）──────────
RAG_EMBED_CACHE_ENABLED=true
# L1 进程内 LRU 上限，1024 维约 4KB/条
RAG_EMBED_CACHE_MAX_ENTRIES=2000
# L2 走 Redis 跨实例共享；Redis 不可用时自动只留 L1
RAG_EMBED_CACHE_REDIS=true
# 远长于分析结果缓存：向量不会像报告那样随时间过期
RAG_EMBED_CACHE_TTL=7d
# 换 embedding 模型时必须换 tag（留空则自动按「来源:模型名:维度」拼）
# RAG_EMBED_MODEL_TAG=ollama:bge-m3:1024

# ── JD 提炼（Agent 工具 getJdRequirements 用的关键词库）────────────
# 两个来源取并集：配置 + 用户笔记标签（动态）
# 默认已内置一份通用 Java 后端词表，这里留空即使用默认
# JD_KEYWORDS=Go,协程,Kubernetes,gRPC
# 是否把「自己导入的笔记标签」作为动态关键词来源（面 Java 得 Java 词，面 Go 得 Go 词）
# JD_DYNAMIC_TAGS=true
# 提炼结果最多返回多少条
# JD_MAX_REQUIREMENTS=12

# ── 业务库（默认 H2 文件库，零依赖；切 PG 用 SPRING_PROFILES_ACTIVE=postgres）
# SPRING_PROFILES_ACTIVE=postgres
BIZ_DB_URL=jdbc:postgresql://localhost:5432/interview_biz
BIZ_DB_USER=postgres
BIZ_DB_PASSWORD=

# ── 向量库 ─────────────────────────────────────────────────────────
VECTOR_DB_URL=jdbc:postgresql://localhost:5432/interview_vector
VECTOR_DB_USER=postgres
VECTOR_DB_PASSWORD=

# ── 鉴权（JWT 无状态）──────────────────────────────────────────────
# 密钥必须自己生成：export JWT_SECRET="$(openssl rand -base64 48)"
# 长度 < 32 字节应用会直接启动失败（快速失败，避免悄悄用弱密钥）
JWT_SECRET=
# token 有效期（秒），默认 24 小时
JWT_TTL=86400
# 关闭后所有接口免鉴权（单用户自用 / 本地调试）
SECURITY_ENABLED=true
# 演示账号 demo/demo123，启动时自动创建；生产建议关闭
DEMO_USER_ENABLED=true

# ── 缓存（Redis，不可用时自动跳过，主流程不受影响）────────────────────
CACHE_ENABLED=true
CACHE_TTL=30m
REDIS_HOST=localhost
REDIS_PORT=6379

# ── 异步分析任务（MQ 不可用时自动降级为本地线程池）─────────────────────
ASYNC_ENABLED=true
# mq = RabbitMQ；pool = 本地线程池
ASYNC_MODE=mq
ASYNC_QUEUE=analysis.task.queue
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=interview
RABBITMQ_PASSWORD=interview
# 消费者并发：不配默认是 1，异步通道吞吐会被钉死在「一次一个」（最容易被忽略的瓶颈）
MQ_CONSUMER_MIN=4
MQ_CONSUMER_MAX=16
# ⚠️ prefetch 必须跟着 concurrency 一起改：默认 250 会让第一个消费者把消息全抓走，
# 其余消费者无活可干，扩容等于没扩。取值 ≈ 单消费者手上的在飞数
MQ_PREFETCH=4

# ── 容量（默认值很容易成为瓶颈，建议显式配置）─────────────────────────
# 业务库连接池：Hikari 默认只有 10，分析接口一次几十秒时十来个并发就打满
DB_POOL_MAX=30
DB_POOL_MIN_IDLE=5
# 拿不到连接时快速失败（默认 30s 太长，会让所有请求一起干等）
DB_CONN_TIMEOUT_MS=5000
# Tomcat 线程
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE=20

# 悬挂任务回收：任务可能因实例崩溃 / 消息丢失永远停在 PENDING，没有补偿前端会一直轮询
# 阈值必须显著大于单次分析最大耗时，否则会误判正常执行的任务
ASYNC_STUCK_MINUTES=10
# 重投这么多次后放弃并标记 FAILED
ASYNC_MAX_RETRY=2
ASYNC_REAPER_INTERVAL_MS=120000

# ── LLM 调用超时（默认无超时，上游挂起会永久占住线程与连接）─────────────
LLM_TIMEOUT_MS=60000

# ── 上游熔断（超时管「单次最多等多久」，熔断管「这段时间干脆别调」）───────
LLM_CB_ENABLED=true
# 窗口内失败率百分比
LLM_CB_FAILURE_RATE=50
# 最小样本数：防止「第一次失败就开路」
LLM_CB_MIN_SAMPLES=5
# 连续失败几次即开路。不能只靠失败率：单次耗时 ≥ 窗口长度时窗口永远被滑空，
# 样本攒不够，失败率统计失效（实测连发 4 次全部各等 61s，一次都没开路）
LLM_CB_CONSECUTIVE=3
# ⚠️ 窗口必须显著大于单次最大耗时（LLM_TIMEOUT_MS），否则统计会被自己的慢调用冲掉
LLM_CB_WINDOW_MS=300000
# 开路后等多久放探测请求
LLM_CB_OPEN_WAIT_MS=30000
# 半开放行几个探测：不能全放，否则上游刚恢复就被瞬间打垮
LLM_CB_HALF_OPEN_PERMITS=2
# 开路时是否退回启发式结果。默认 false —— 悄悄返回低质量分析比报错更糟
LLM_CB_FALLBACK=false

# ── 指标：LLM 耗时的分位数 ────────────────────────────────────────
# 默认开启 histogram 分桶（跨实例可聚合），此时 Prometheus 只有 _bucket，没有直读的 quantile。
# 设为 false 才会输出 llm_call_duration_seconds{quantile="0.95"}（单机排查更直观）。
# 两者在 Prometheus 下互斥，实测验证过。
MANAGEMENT_METRICS_DISTRIBUTION_PERCENTILES_HISTOGRAM_LLM_CALL_DURATION=true

# ── 限流（频率 + 并发双维度；Redis 不可用时降级放行 / 并发退化为本机计数）──
RATELIMIT_ENABLED=true
# 频率：防脚本。按方法定制见 application.yml 的 app.ratelimit.rules
RATELIMIT_QPM=60
# 并发：保护线程池与连接池 —— 真正占资源的是「同时在跑几个」，不是「一分钟来几次」
RATELIMIT_MAX_IN_FLIGHT=2
RATELIMIT_GLOBAL_IN_FLIGHT=32

# ── 调试端点（暴露连接串与注入 prompt，对外部署建议 false）─────────────
DEBUG_ENDPOINTS=true
